# Copy to `.env.local` for development. Set the same names in the Vercel
# dashboard for a deployment. Nothing here is secret; every value is a
# placeholder.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Absent  → PGlite, Postgres compiled to WASM, running in-process.
# Present → node-postgres against the real server.
#
# THIS IS NOT OPTIONAL IN A DEPLOYMENT. Without it the app falls back to the
# embedded backend, which on a serverless host is a fresh in-memory database per
# invocation: writes vanish, nothing is shared between requests, and nothing
# reports an error. Check `/api/v1/health` says "backend":"pg" after deploying.
#
# Use Neon's POOLED connection string — the host contains `-pooler`. The direct
# endpoint opens one Postgres backend per connection and a free project runs out
# during ordinary traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Pool size per process. Defaults to 2 on Vercel and 10 elsewhere; override only
# if you know why. See the reasoning in src/lib/db.ts.
# RELAY_PG_MAX=2

# Forces a backend regardless of DATABASE_URL. Used by the test harness. Leave
# unset in every deployment.
# RELAY_DB=embedded

# Per-file schema isolation for the test suite. Never set this in a deployment.
# RELAY_PG_SCHEMA=test_abc123

# ─────────────────────────────────────────────────────────────────────────────
# Scheduler
# ─────────────────────────────────────────────────────────────────────────────

# Required by POST /api/v1/ops/drain when set, ignored when absent.
#
# Set it in BOTH the Vercel project and the Render cron job, to the same value.
# Absent in a deployment means anyone who finds the URL can make your database
# do work on demand — harmless to the data, expensive on a metered free tier.
#
# Generate one: openssl rand -hex 32
CRON_SECRET=

# Read by the Render cron job only, not by the app. No trailing slash.
MOVE_RELAY_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────

# Absolute base for canonical URLs and social card images. Vercel provides
# VERCEL_URL automatically, but it changes per deployment, so set this to the
# stable production domain.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# AI (all optional — the deterministic path is the designed floor, not a
# degraded mode)
# ─────────────────────────────────────────────────────────────────────────────

# Set to use the hosted model path. Leave unset to run deterministically.
# ANTHROPIC_API_KEY=

# A local Ollama, preferred over a hosted key when no key is set. Not reachable
# from a deployment, so this is a development-only convenience.
# OLLAMA_HOST=http://127.0.0.1:11434
# RELAY_AI_MODEL=llama3.1:8b

# Hard-disables model calls even when one would otherwise resolve.
# RELAY_AI_DISABLE=1
