{
  "name": "move-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Move Relay — verified handoff infrastructure. Proof of work for Utility Connect.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:db": "node scripts/verify-constraints.mjs",
    "verify": "npm run verify:db && vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "pg": "^8.13.1",
    "postprocessing": "^6.39.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
