{
  "name": "move-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Move Relay — verified handoff infrastructure. Proof of work for Utility Connect.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "framer-motion": "^12.42.2",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "vitest": "^2.1.8"
  }
}
